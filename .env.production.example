APP_ENV=production
APP_NAME=VPN Platform
API_PUBLIC_URL=https://bot.vpn.example
MINIAPP_PUBLIC_URL=https://bot.vpn.example
MINIAPP_TELEGRAM_URL=/cabinet?app=1
TELEGRAM_MINIAPP_LAUNCH_URL=https://t.me/your_bot?startapp=cabinet&mode=fullscreen

POSTGRES_PASSWORD=replace-with-a-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_AUTH_DEV_BYPASS=false

VPN_PROVIDER=remnawave
REMNAWAVE_BASE_URL=https://panel.vpn.example
REMNAWAVE_API_TOKEN=replace-with-remnawave-api-token
REMNAWAVE_DEFAULT_SQUAD_UUIDS=

YOOKASSA_ENABLED=true
YOOKASSA_SHOP_ID=replace-with-yookassa-shop-id
YOOKASSA_SECRET_KEY=replace-with-yookassa-secret-key
YOOKASSA_RETURN_URL=https://bot.vpn.example/cabinet#dashboard
YOOKASSA_WEBHOOK_PATH=/api/v1/payments/yookassa/webhook
YOOKASSA_DESCRIPTION_PREFIX=VPN Platform

HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
