diff --git a/common/protocol/user.go b/common/protocol/user.go
index 75e8e65..50d05ba 100644
--- a/common/protocol/user.go
+++ b/common/protocol/user.go
@@ -1,6 +1,7 @@
 package protocol
 
 import (
+	"sync"
 	"github.com/xtls/xray-core/common/errors"
 	"github.com/xtls/xray-core/common/serial"
 )
@@ -52,4 +53,19 @@ type MemoryUser struct {
 	Account Account
 	Email   string
 	Level   uint32
+	revokeInit sync.Once
+	revokeOnce sync.Once
+	revoked chan struct{}
+}
+
+// Revoked is scoped to this credential generation, never to a shared client IP.
+func (u *MemoryUser) Revoked() <-chan struct{} {
+	u.revokeInit.Do(func() { u.revoked = make(chan struct{}) })
+	return u.revoked
+}
+
+// Revoke terminates authenticated sessions when the validator removes this user.
+func (u *MemoryUser) Revoke() {
+	u.Revoked()
+	u.revokeOnce.Do(func() { close(u.revoked) })
 }
