APP_ENV=development
APP_NAME=VPN Platform
API_PUBLIC_URL=http://localhost:8080
MINIAPP_PUBLIC_URL=http://localhost:5173
MINIAPP_TELEGRAM_URL=/cabinet?app=1
# Telegram deep-link used by public-site buttons (replace the bot username).
TELEGRAM_MINIAPP_LAUNCH_URL=https://t.me/your_bot?startapp=cabinet
DATABASE_URL=postgresql+asyncpg://vpn:vpn@postgres:5432/vpn
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_AUTH_DEV_BYPASS=false
BOT_OWNER_TELEGRAM_IDS=
VPN_PROVIDER=remnawave
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_DEFAULT_SQUAD_UUIDS=
USAGE_SYNC_INTERVAL_SECONDS=21600
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/cabinet#dashboard
YOOKASSA_WEBHOOK_PATH=/api/v1/payments/yookassa/webhook
YOOKASSA_DESCRIPTION_PREFIX=VPN Platform
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
